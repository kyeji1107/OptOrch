reset;
model OptOrch_core.mod;
data OptOrch.dat;

data b.dat;
data l.dat;
data u.dat;
data c.dat;

option solver GUROBI;
option gurobi_options 'outlev=1 mipgap=0.05';

solve;
display gain;

# Export selected individuals (r=1) and their p-values to a CSV
printf "Individual_ID,p_value\n" > "output/selected_individuals.csv";
printf {i in S: r[i] > 0.5} "%d,%f\n", i, p[i] >> "output/selected_individuals.csv";
